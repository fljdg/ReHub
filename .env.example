# --- Supabase Postgres ---
# Supabase dashboard -> click "Connect" (top of the project page) -> pick "Session pooler".
# Session pooler works on IPv4 and IPv6. The direct connection (db.<ref>.supabase.co)
# is IPv6-only unless you buy the IPv4 add-on, so it often fails on home networks.
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_database_password
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
